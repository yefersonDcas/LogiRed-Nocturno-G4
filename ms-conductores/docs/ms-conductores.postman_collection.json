                "usuarios"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Flota\",\n  \"email\": \"flota@empresa.com\",\n  \"password\": \"{{passwordPruebas}}\",\n  \"rol\": \"flota\"\n}",
              "options": {
