    {
      "name": "07 Crear con datos válidos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/conductores",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "conductores"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"María Torres\",\n  \"cedula\": \"{{cedulaNueva}}\",\n  \"categoria_licencia\": \"C2\",\n  \"telefono\": \"+573001112233\",\n  \"sede\": \"Cali\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201', () => pm.response.to.have.status(201));",
              "pm.test('Trae cabecera Location', () => pm.response.to.have.header('Location'));",
              "pm.collectionVariables.set('nuevoId', pm.response.json().id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Cédula nueva en cada ejecución para que la prueba se pueda repetir",
              "pm.collectionVariables.set('cedulaNueva', String(Date.now()).slice(-10));"
            ]
          }
        }
      ]
    },
