{
  "info": {
    "name": "ms-conductores (LogiRed)",
    "description": "Pruebas del Taller 2 para ms-conductores (casos 1 a 24). Orden: carpeta 0 (login), 1 (CRUD), 2 (seguridad) y 3 (relación con ms-envios). Necesita ms-usuarios (3001) y ms-conductores (3004); la carpeta 3 además ms-clientes (3002) y ms-envios (3003).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tokenAdmin}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Login (sacar los tokens)",
      "description": "Ejecutar primero. Necesita ms-usuarios corriendo en el puerto 3001 con la misma JWT_SECRET. Cada login guarda su token en una variable de la colección.",
      "item": [
        {
          "name": "0.1 Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{usuariosUrl}}/usuarios/login",
              "host": [
                "{{usuariosUrl}}"
              ],
              "path": [
                "usuarios",
                "login"
              ]
            },
            "description": "Inicia sesión en ms-usuarios (puerto 3001) y guarda el token en la variable tokenAdmin.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@empresa.com\",\n  \"password\": \"{{passwordAdmin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenAdmin', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 Login despacho",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{usuariosUrl}}/usuarios/login",
              "host": [
                "{{usuariosUrl}}"
              ],
              "path": [
                "usuarios",
                "login"
              ]
            },
            "description": "Inicia sesión en ms-usuarios (puerto 3001) y guarda el token en la variable tokenDespacho.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"despacho@empresa.com\",\n  \"password\": \"{{passwordPruebas}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenDespacho', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "0.3 Login flota",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{usuariosUrl}}/usuarios/login",
              "host": [
                "{{usuariosUrl}}"
              ],
              "path": [
                "usuarios",
                "login"
              ]
            },
            "description": "Inicia sesión en ms-usuarios (puerto 3001) y guarda el token en la variable tokenFlota.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"flota@empresa.com\",\n  \"password\": \"{{passwordPruebas}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenFlota', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. CRUD (casos 1 a 13, como administrador)",
      "description": "Todas usan el token del administrador (heredado de la colección).",
      "item": [
        {
          "name": "01 Listar todos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conductores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conductores"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Filtrar por sede",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conductores?sede=Cali",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conductores"
              ],
              "query": [
                {
                  "key": "sede",
                  "value": "Cali"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Todos son de Cali', () => pm.response.json().forEach((c) => pm.expect(c.sede).to.eql('Cali')));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Consultar por lotes (?ids=)",
