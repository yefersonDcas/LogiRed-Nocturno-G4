        {
          "name": "01 Listar todos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conductores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conductores"
