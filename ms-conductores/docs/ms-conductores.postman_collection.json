{
  "info": {
    "name": "ms-conductores",
    "description": "Casos de prueba del Taller 2 (1 a 13) para ms-conductores · LogiRed. Ejecutar en orden: el 07 guarda el id que usan el 10, 12 y 13.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Listar todos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/conductores",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "conductores"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Devuelve un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Filtrar por sede",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/conductores?sede=Cali",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "conductores"
          ],
          "query": [
            {
              "key": "sede",
              "value": "Cali"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Todos son de Cali', () => pm.response.json().forEach((c) => pm.expect(c.sede).to.eql('Cali')));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Consultar por lotes (?ids=)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/conductores?ids=1,3",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "conductores"
          ],
          "query": [
            {
              "key": "ids",
              "value": "1,3"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Solo trae los ids pedidos', () => pm.response.json().forEach((c) => pm.expect([1, 3]).to.include(c.id)));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Obtener un registro existente",
      "request": {
        "method": "GET",
        "header": [],
