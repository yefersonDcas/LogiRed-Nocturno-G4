          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Todos son de Cali', () => pm.response.json().forEach((c) => pm.expect(c.sede).to.eql('Cali')));"
