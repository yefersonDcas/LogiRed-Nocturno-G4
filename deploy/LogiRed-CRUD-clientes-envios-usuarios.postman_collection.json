{
  "info": {
    "name": "LogiRed · Taller 3 · CRUD clientes, envíos y usuarios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CRUD completo de ms-clientes, ms-envios y ms-usuarios por el gateway https://app.logiredtech.co/api. Primero corre \"0 Login\". SSL certificate verification apagado en Settings."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tokenAdmin}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://app.logiredtech.co/api"
    },
    {
      "key": "passwordAdmin",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "docCliente",
      "value": ""
    },
    {
      "key": "idCliente",
      "value": ""
    },
    {
      "key": "idEnvio",
      "value": ""
    },
    {
      "key": "idUsuario",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 Login",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/usuarios/login",
            "description": "Escribe la contraseña del admin en la pestaña Variables (passwordAdmin) o directamente aquí en el Body.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@empresa.com\",\n  \"password\": \"{{passwordAdmin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenAdmin', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
